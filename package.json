{
  "name": "binance-client",
  "version": "1.0.0",
  "description": "Binance USDⓈ-M Futures JavaScript Library",
  "main": "binance-futures-client.js",
  "types": "binance-futures-client.d.ts",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node tests/unit/client_unit_test.js",
    "check:syntax": "node --check binance-futures-client.js && node --check tests/unit/client_unit_test.js",
    "verify:exports": "node -e \"const pkg = require('./binance-futures-client'); const required = ['BinanceFuturesClient','BinanceError','BinanceAPIError','BinanceNetworkError']; for (const key of required) { if (!pkg[key]) throw new Error('Missing export: '+key); } console.log('exports ok')\"",
    "verify": "npm run check:syntax && npm run test:unit && npm run verify:exports && npm pack --dry-run"
  },
  "keywords": [
    "binance",
    "futures",
    "usds-m",
    "api",
    "client",
    "crypto"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.17.0",
    "dotenv": "^16.6.1",
    "technicalindicators": "^3.1.0",
    "ws": "^8.21.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/binance-client-js.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/binance-client-js/issues"
  },
  "homepage": "https://github.com/shubhamtaywade82/binance-client-js#readme"
}
